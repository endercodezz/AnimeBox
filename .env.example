# AnimeBox runtime configuration
# Copy to .env. Never commit .env.

# Local web server. Keep loopback unless you intentionally expose AnimeBox to LAN.
HOST=127.0.0.1
PORT=8787

# Relative paths resolve from project root. Absolute paths also work.
LIBRARY_PATH=./library
DATABASE_URL=sqlite+aiosqlite:///./data/animebox.db

# DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Optional proxy for geo-restricted providers.
# Accepted examples: http://127.0.0.1:7890 or socks5://user:password@host:1080
# HTTP_PROXY=

# Voiceover names, comma-separated in priority order.
PREFERRED_VOICEOVERS=AniLibria,AnimeVost,Aniliberty,Animevost

# Closest available stream quality is selected.
DEFAULT_QUALITY=1080

# Steam Deck optimization defaults used when enabled in UI.
STEAM_DECK_CRF=23
STEAM_DECK_HEIGHT=720

# CORS origins use pydantic JSON list syntax when overridden.
# CORS_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173"]
