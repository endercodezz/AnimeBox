# AnimeBox runtime configuration
# Copy to .env. Never commit .env.
# Most of these can also be changed in the UI (Settings); UI values take precedence.

# Local web server. Keep loopback unless you intentionally expose AnimeBox to your LAN.
HOST=127.0.0.1
PORT=8787
# Extra Host header values to accept besides 127.0.0.1/localhost (JSON list), e.g. a LAN hostname.
# Requests with any other Host are rejected to block DNS-rebinding attacks.
# ALLOWED_HOSTS=["animebox.lan"]

# Relative paths resolve from the AnimeBox folder. Absolute paths also work.
LIBRARY_PATH=./library
DATA_PATH=./data
DATABASE_URL=sqlite+aiosqlite:///./data/animebox.db

# DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Optional proxy for search, playback and downloads (they always share one network path).
# Examples: http://127.0.0.1:7890 or socks5://user:password@host:1080
# HTTP_PROXY=

# Per-stage time limits for each provider, in seconds. Slow providers are reported, not waited for.
PROVIDER_SEARCH_TIMEOUT=10
PROVIDER_DETAIL_TIMEOUT=25
PROVIDER_STREAM_TIMEOUT=25

# Voiceover names, comma-separated, in priority order (case-insensitive substring match).
PREFERRED_VOICEOVERS=AniLibria,AnimeVost,Aniliberty

# Closest available quality not above this value is selected (360, 480, 720, 1080).
DEFAULT_QUALITY=1080

# Parallel downloads (1-6).
MAX_CONCURRENT_DOWNLOADS=2

# Steam Deck optimization defaults used when enabled in Settings.
STEAM_DECK_CRF=23
STEAM_DECK_HEIGHT=720

# Idle lifetime of a playback session (seconds). Expired sessions are re-resolved automatically.
MEDIA_SESSION_TTL=14400

# CORS origins for the Vite dev server (JSON list).
# CORS_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173"]
