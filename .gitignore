# Local configuration and secrets
.env
.env.*
!.env.example

# Python
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
*.egg-info/

# Frontend
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/*.local

# Runtime data — keep directory placeholders only
/data/*
!/data/.gitkeep
/library/*
!/library/.gitkeep
*.db
*.db-shm
*.db-wal
*.part

# Local upstream reference checkouts are cloned by install/release scripts.
# AnimeBox compatibility changes belong in tracked patches/, never as hidden edits here.
/.references/*
!/.references/.gitkeep

# Portable output — keep release source/spec/docs
/release/work/
/release/dist/
/release/artifacts/
/release/tools-cache/
/release/**/*.zip
/release/**/*.tar.gz
/release/**/*.sha256
/release/**/ffmpeg
/release/**/ffmpeg.exe

# Logs and diagnostics
*.log
logs/
*.pid
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Generated screenshots and probes
/player-*.png
/ui-*.png
/*-live.png
/*-verify.png
/tmp/

# IDE / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo

# Claude local state
.claude/
claude.md
